# Forge-Zero environment
# Copy to .env (never commit it) or export in your shell / process manager.

# Port + bind address (0.0.0.0 so container and preview proxies can reach it)
PORT=3000
FORGE_HOST=0.0.0.0
NODE_ENV=development

# Key-encryption secret for provider API keys stored in SQLite.
# If unset, the server generates one at data/.forge-secret (mode 0600).
# Set this explicitly when the data directory might be restored on another host.
FORGE_SECRET=

*** Where the SQLite database and the generated secret live (relative to repo root)
FORGE_DATA_DIR=data

# Live "run stage from the browser" feature. The prompt pack itself needs no
# network; turning this off removes only the proxy.
FORGE_ALLOW_GENERATE=1
FORGE_GENERATE_TIMEOUT_MS=180000

# Per-IP limiter on /api for instances exposed beyond localhost
FORGE_HTTP_RATE=120

# Optional: keys straight from the environment (the DB entries in the Keys panel
# take precedence). One variable per provider id in the catalogue.
# FORGE_GROQ_API_KEY=
FORGE_GOOGLE_API_KEY=
*** FORGE_CEREBRAS_API_KEY=
# FORGE_MISTRAL_API_KEY=
*** FORGE_OPENROUTER_API_KEY=
*** FORGE_NVIDIA_API_KEY=
*** FORGE_ZAI_API_KEY=
*** Cloudflare Workers AI needs an account id in addition to the token
CF_ACCOUNT_ID=

# Cap on brief size accepted by the composer (prompt-injection and OOM guard)
FORGE_MAX_BRIEF_CHARS=40000
